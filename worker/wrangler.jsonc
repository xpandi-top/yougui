// 有归 云同步服务。部署前：wrangler d1 create yougui / wrangler r2 bucket create yougui-files，
// 把 d1 的 database_id 填到下面，再 npm run migrate:remote && npm run deploy。见 docs/DEPLOY.md。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yougui-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "yougui", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "yougui-files" }],
  "vars": {
    // 允许调用 API 的前端来源，逗号分隔（GitHub Pages 地址、本地开发地址）
    "ALLOWED_ORIGINS": "http://localhost:5180,http://localhost:4180,http://127.0.0.1:5180",
    "MAX_FILE_BYTES": "20971520",
    "QUOTA_BYTES": "5368709120"
  },
  // 每天清理：超过 24 小时仍无附件记录的孤儿文件、已删除附件的文件
  "triggers": { "crons": ["17 3 * * *"] }
  // 生产环境请设置创建口令：wrangler secret put SETUP_SECRET
}
