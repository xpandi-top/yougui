{
  "name": "yougui-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "有归 可选云同步服务：Cloudflare Worker + Hono + D1 + R2",
  "scripts": {
    "dev": "wrangler dev --local --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply yougui --local",
    "migrate:remote": "wrangler d1 migrations apply yougui --remote",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}
