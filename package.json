{
  "name": "yougui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "有归 Homebase — 家庭收纳登记 PWA（本地优先，可选云同步）",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "core:check": "tsc -p tsconfig.core.json",
    "i18n:check": "node scripts/i18n-check.mjs --strict",
    "budget": "node scripts/bundle-budget.mjs",
    "verify": "node scripts/verify.mjs",
    "worker:dev": "npm --prefix worker run dev",
    "worker:test": "npm --prefix worker test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "workbox-window": "^7.4.1"
  }
}
